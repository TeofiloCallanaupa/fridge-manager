# EAS Build ignore — same as .gitignore but includes dist/ for shared package

# Dependencies
node_modules/
.pnpm-store/

# Build output (NOT dist/ — needed for @fridge-manager/shared)
.next/
out/

# Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Environment
.env
.env.local
.env.test
.env.*.local
.env.sentry-build-plugin

# Supabase
supabase/.temp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
__tests__/
**/__tests__/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Playwright
playwright-report/
test-results/
