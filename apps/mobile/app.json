{
  "expo": {
    "name": "Fridge Manager",
    "slug": "fridge-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teofilo.fridgemanager"
    },
    "android": {
      "package": "com.teofilo.fridgemanager",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "fridgemanager",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#206140"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "self-nyp",
          "project": "fridge-manager-mobile"
        }
      ],
      "expo-font",
      "@sentry/react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bef729e4-9b9d-4766-808d-9e0267fea2f9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bef729e4-9b9d-4766-808d-9e0267fea2f9"
    }
  }
}
